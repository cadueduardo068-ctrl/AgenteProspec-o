{
  "name": "cadu-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "worker": "tsx --env-file-if-exists=.env.local workers/runner.ts",
    "password": "node scripts/password.mjs",
    "test:e2e": "tsx --test tests/http.e2e.ts",
    "format": "prettier --write src workers tests scripts next.config.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.163.0",
    "@supabase/supabase-js": "2.118.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
