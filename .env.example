# Copy to .env.local. Blank values mean integration is not configured.
APP_URL=http://127.0.0.1:3000
DATABASE_DRIVER=sqlite
LOCAL_DATA_DIR=.local
# Production requires a generated hash (npm run password) and random session secret.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_MARKETING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
OPENAI_API_KEY=
OPENAI_MODEL=
# Separate trusted worker endpoint; never execute generated code in the web process.
GENERATOR_URL=
GENERATOR_TOKEN=
PREVIEW_ORIGIN=
WORKER_TOKEN=
# Estimated unit cost is entered by admin; not a current Google price quote.
PLACES_ESTIMATED_COST_PER_REQUEST_BRL=0
PRIVACY_CONTACT=
